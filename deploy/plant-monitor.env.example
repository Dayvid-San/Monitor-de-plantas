# Copie para /etc/plant-monitor.env (systemd) ou use com `docker run --env-file`.
# Todas as variáveis são opcionais.

# Porta HTTP do backend (padrão 3000)
#PORT=3000

# Chave exigida em /api/ingest/* e /api/devices/* (header X-API-Key).
# Use o mesmo valor em "Chave de API" no menuconfig dos ESP32. Vazio = sem exigência.
#DEVICE_API_KEY=troque-esta-chave

# Origens extras permitidas por CORS, separadas por vírgula. Vazio = só mesma origem
# (o dashboard é servido pelo próprio backend, então normalmente não precisa).
#CORS_ORIGINS=http://meu-painel.local:8080

# Onde ficam plants.db, photos/ e vapid.json (padrão: ./data)
#DATA_DIR=data

# Quantos dias guardar cada tipo de dado; 0 desliga a limpeza daquele tipo.
#READINGS_RETENTION_DAYS=90
#PHOTOS_RETENTION_DAYS=30
#EVENTS_RETENTION_DAYS=180
